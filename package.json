{
	"name": "patuna-hajj-companion",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler pages dev .svelte-kit/cloudflare --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"gen": "wrangler types",
		"deploy": "bun run build && wrangler pages deploy .svelte-kit/cloudflare --project-name hajj-companion --branch main"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"md-to-pdf": "^5.2.5",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"qrcode": "^1.5.4",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vite-plugin-pwa": "^1.2.0",
		"workbox-window": "^7.4.0",
		"wrangler": "^4.81.0"
	},
	"dependencies": {
		"@fontsource-variable/manrope": "^5.2.8",
		"@fontsource-variable/piazzolla": "^5.2.8",
		"@fontsource/noto-naskh-arabic": "^5.2.11",
		"@supabase/supabase-js": "^2.105.1",
		"gsap": "^3.15.0",
		"motion": "^12.38.0",
		"phosphor-svelte": "^3.1.0"
	}
}
